<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
    </plugin>
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <physics type="ode">
      <real_time_update_rate>100</real_time_update_rate>
      <max_step_size>0.01</max_step_size>
      <real_time_factor>0</real_time_factor> 
    </physics>

    <model name="outer_wall_top">
      <pose>0 5.5 0.25 0 0 0</pose>
      <static>true</static>
      <link name="link"><collision name="col"><geometry><box><size>11.2 0.2 0.5</size></box></geometry></collision><visual name="vis"><geometry><box><size>11.2 0.2 0.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual></link>
    </model>
    
    <model name="outer_wall_bottom">
      <pose>0 -5.5 0.25 0 0 0</pose>
      <static>true</static>
      <link name="link"><collision name="col"><geometry><box><size>11.2 0.2 0.5</size></box></geometry></collision><visual name="vis"><geometry><box><size>11.2 0.2 0.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual></link>
    </model>

    <model name="outer_wall_left">
      <pose>5.5 0 0.25 0 0 0</pose>
      <static>true</static>
      <link name="link"><collision name="col"><geometry><box><size>0.2 11.0 0.5</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.2 11.0 0.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual></link>
    </model>

    <model name="outer_wall_right">
      <pose>-5.5 0 0.25 0 0 0</pose>
      <static>true</static>
      <link name="link"><collision name="col"><geometry><box><size>0.2 11.0 0.5</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.2 11.0 0.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual></link>
    </model>

    <model name="wall_center_top">
      <pose>0 2.5 0.25 0 0 0</pose>
      <static>true</static>
      <link name="link"><collision name="col"><geometry><box><size>3.0 0.2 0.5</size></box></geometry></collision><visual name="vis"><geometry><box><size>3.0 0.2 0.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual></link>
    </model>

    <model name="wall_center_bottom">
      <pose>0 -2.5 0.25 0 0 0</pose>
      <static>true</static>
      <link name="link"><collision name="col"><geometry><box><size>3.0 0.2 0.5</size></box></geometry></collision><visual name="vis"><geometry><box><size>3.0 0.2 0.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual></link>
    </model>

    <model name="wall_top_left_vert">
      <pose>3.0 4.0 0.25 0 0 0</pose>
      <static>true</static>
      <link name="link"><collision name="col"><geometry><box><size>0.2 3.0 0.5</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.2 3.0 0.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual></link>
    </model>

    <model name="wall_bottom_left">
      <pose>3.0 -4.0 0.25 0 0 0</pose>
      <static>true</static>
      <link name="link"><collision name="col"><geometry><box><size>0.2 3.0 0.5</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.2 3.0 0.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual></link>
    </model>

    <model name="wall_top_right">
      <pose>-2.5 3.0 0.25 0 0 0</pose>
      <static>true</static>
      <link name="link"><collision name="col"><geometry><box><size>1.5 0.2 0.5</size></box></geometry></collision><visual name="vis"><geometry><box><size>1.5 0.2 0.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual></link>
    </model>

    <model name="wall_bottom_right_vert">
      <pose>-3.0 -4.0 0.25 0 0 0</pose>
      <static>true</static>
      <link name="link"><collision name="col"><geometry><box><size>0.2 3.0 0.5</size></box></geometry></collision><visual name="vis"><geometry><box><size>0.2 3.0 0.5</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual></link>
    </model>

 <model name="obs_1">
      <pose>2.5 0 0.25 0 0 0</pose>
      <link name="link">
      
        <kinematic>1</kinematic>
        <gravity>0</gravity>
        
        <inertial><mass>1.0</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <collision name="col"><geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
      </link>
      <plugin name="mover" filename="libgazebo_ros_planar_move.so">
        <ros><namespace>/obs1</namespace></ros>
        <update_rate>100</update_rate><publish_odom>false</publish_odom>
      </plugin>
    </model>

    <model name="obs_2">
      <pose>-2.5 0 0.25 0 0 0</pose>
      <static>false</static>
      <link name="link">
      
        <kinematic>1</kinematic>
        <gravity>0</gravity>
        
        <inertial><mass>1.0</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <collision name="col"><geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
      </link>
      <plugin name="mover" filename="libgazebo_ros_planar_move.so">
        <ros><namespace>/obs2</namespace></ros>
        <update_rate>100</update_rate><publish_odom>false</publish_odom>
      </plugin>
    </model>

  </world>
</sdf>