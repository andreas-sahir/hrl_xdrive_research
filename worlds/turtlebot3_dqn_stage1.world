<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
  <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
    </plugin>
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <physics type="ode">
      <real_time_update_rate>100</real_time_update_rate>
      <max_step_size>0.01</max_step_size>
      <real_time_factor>0</real_time_factor> 
    </physics>

    <model name="wall_top">
      <pose>0 5.5 0.25 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry>
            <box>
              <size>11.2 0.2 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <box>
              <size>11.2 0.2 0.5</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_bottom">
      <pose>0 -5.5 0.25 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry>
            <box>
              <size>11.2 0.2 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <box>
              <size>11.2 0.2 0.5</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_left">
      <pose>5.5 0 0.25 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry>
            <box>
              <size>0.2 11.0 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <box>
              <size>0.2 11.0 0.5</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_right">
      <pose>-5.5 0 0.25 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry>
            <box>
              <size>0.2 11.0 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <box>
              <size>0.2 11.0 0.5</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>